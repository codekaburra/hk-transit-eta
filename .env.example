# Backend environment variables
DATABASE_URL=postgres://hkbus:hkbus_password@localhost:5432/hkbus?sslmode=disable
PORT=8080
CORS_ORIGINS=http://localhost,http://localhost:80

# Shared secret for POST /api/admin/refresh (X-Admin-Token header).
# Leave unset to disable the refresh endpoint entirely.
ADMIN_TOKEN=

# Frontend build argument (baked in at docker build time)
REACT_APP_API_URL=/api
