# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real secrets.
#
# TLS/HTTPS is handled OUTSIDE this stack by your existing reverse proxy or
# load balancer. The frontend serves plain HTTP on ${FRONTEND_PORT}; point
# your proxy at that port.

# ── Networking ──────────────────────────────────────────────────────
# Host port the frontend (nginx) listens on, for your TLS proxy to forward to.
FRONTEND_PORT=80

# ── Database ────────────────────────────────────────────────────────
POSTGRES_DB=hkbus
POSTGRES_USER=hkbus
# CHANGE THIS in production — use a long random secret.
POSTGRES_PASSWORD=change_me_in_production
# DATABASE_URL is derived from the three vars above in docker-compose.yaml,
# so you normally don't set it here. Override only for an external database.

# ── Backend ─────────────────────────────────────────────────────────
PORT=8080
# Allowed CORS origins (comma-separated). In production, your https domain.
CORS_ORIGINS=https://your-domain.example.com
# Shared secret for POST /api/admin/refresh (X-Admin-Token header).
# Leave empty to disable the refresh endpoint entirely.
ADMIN_TOKEN=

# ── Frontend (baked in at docker build time) ────────────────────────
# Same-origin API path, served through nginx. Leave as /api.
REACT_APP_API_URL=/api
